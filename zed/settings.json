// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "cli_default_open_behavior": "existing_window",
    "ui_font_family": "Noto Mono",
    "terminal": {
        "font_size": 15.0,
        "font_family": "Noto Mono",
    },
    "semantic_tokens": "combined",
    "lsp_highlight_debounce": 300,
    "global_lsp_settings": {
        "semantic_token_rules": [
            {
                "token_type": "parameter",
                "foreground_color": "#0D6A3D",
                "font_style": "italic",
            },
            {
                "token_type": "enum",
                "foreground_color":"#ffc85a"
            },

            {
                "token_type": "enumMember",
                "foreground_color":"#ffc85a",
                "font_style":"normal"
            }
        ],
    },

    "which_key": {
        "enabled": true,
    },
    "outline_panel": {
        "button": false,
        "dock": "left",
    },
    "collaboration_panel": {
        "button": false,
        "dock": "left",
    },
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "dock": "right",
    },
    "icon_theme": "VSCode Icons for Zed (Light Angular)",
    "tab_size": 4,
    "show_edit_predictions": false,
    "project_panel": {
        "dock": "right",
        "default_width": 370,
        "entry_spacing": "standard",
    },
    "helix_mode": true,
    "vim_mode": true,
    "vim": {
        "default_mode": "normal",
    },

    "ui_font_size": 16,
    "buffer_font_family": "DejaVu Sans Mono",
    "buffer_font_size": 14,
    "preferred_line_length": 100,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "VSCode Dark Polished",
    },
    "current_line_highlight": "none",
    "cursor_blink": false,
    "selection_highlight": true,
    // "cursor_shape": "hollow",
    "tabs": {
        "file_icons": true,
    },
    "toolbar": {
        "breadcrumbs": false,
        "agent_review": false,
        "selections_menu": false,
        "quick_actions": false,
    },
    "experimental.theme_overrides": {
        // "editor.background": "#ffffff"
        // "editor.document_highlight.read_background": "#000000",
        // "editor.document_highlight.write_background": "#000000",
        "hint": "#494949", //git blame color
        "syntax": {
            "keyword": {
                "color": "#9872A2",
            },
            "function": {
                "color": "#d97705",
            },
            "string": {
                "color": "#9AA83A",
            },
            "punctuation": {
                "color": "#676867",
            },
            "punctuation.bracket": {
                "color": "#676867",
            },
            "punctuation.delimiter": {
                "color": "#676867",
            },
            "punctuation.special": {
                "color": "#676867",
            },
            "operator": {
                "color": "#676867",
            },
            "number": {
                "color": "#408080",
            },
            "boolean": {
                "color": "#408080",
            },
            // not working?
            "attribute": {
                // "color": "#D0B344"
            },

            "comment": {
                "color": "#525252",
            },
            "comment.doc": {
                "color": "#525252",
            },
            //null, undefined
            "constant.builtin": {
                "color": "#408080",
            },
            // this, super
            "variable.special": {
                "color": "#C7444A",
            },
            // TESTING HERE
            // needs to be contributed
            // https://github.com/zed-industries/zed/blob/main/crates/languages/src/javascript/highlights.scm
            "enum": {
                "color": "#ff0000",
            },
            "enum.member": {
                "color": "#ff0000",
            },
            "pattern.identifier": {
                "color": "#C7444A",
            },
        },
    },
}
