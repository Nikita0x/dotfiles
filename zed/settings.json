// // Zed settings
// //
// // For information on how to configure Zed, see the Zed
// // documentation: https://zed.dev/docs/configuring-zed
// //
// // To see all of Zed's default settings without changing your
// // custom settings, run `zed: open default settings` from the
// // command palette (cmd-shift-p / ctrl-shift-p)
//
{
  "cli_default_open_behavior": "new_window",
  "helix_mode": true,
  "soft_wrap": "editor_width",
  "format_on_save": "on",

  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "ui_font_family": "Noto Mono",
  "terminal": {
    "font_size": 15.0,
    "font_family": "Noto Mono",
  },
  "cursor_blink": false,
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all", //possible contribution? missing those "three values" in the description (all, errors, off)
  },
  "toolbar": {
    "code_actions": false,
    "breadcrumbs": false,
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
  },
  "show_edit_predictions": true,
  "current_line_highlight": "all",

  // Things provided by Extensions.
  "icon_theme": "VSCode Great Icons Theme",
  // "theme": {
  //   "light": "Ayu Dark",
  //   "dark": "VSCode Dark Modern",
  // },

  // Syntax highlighting related
  "semantic_tokens": "combined", // Use LSP semantic tokens together with tree-sitter highlighting. Tree-sitter provides base highlighting, and semantic tokens overlay additional information.

  "global_lsp_settings": {
    "semantic_token_rules": [
      {
        "token_type": "parameter",
        "foreground_color": "#0D6A3D",
        "font_style": "italic",
      },
      {
        "token_type": "typeParameter",
        "foreground_color": "#0D6A3D",
        "font_style": "italic",
      },
      {
        "token_type": "enum",
        "foreground_color": "#ffc85a",
      },
      {
        "token_type": "enumMember",
        "foreground_color": "#ffc85a",
      },
      {
        "token_type": "import",
        "foreground_color": "#ffc85a",
      },

      {
        "token_type": "punctuation",
        "foreground_color": "#ff0000",
      },
      {
        "token_type": "function",
        "foreground_color": "#d97705",
      },
      {
        "token_type": "method",
        "foreground_color": "#d97704",
      },
      {
        "token_type": "string",
        "foreground_color": "#ff0000",
      },

      {
        "token_type": "property",
        "foreground_color": "#88c7ed",
      },
      {
        "token_type": "variable",
        "foreground_color": "#3B8CB8",
        "token_modifiers": ["readonly"],
      },
      {
        "token_type": "variable",
        "foreground_color": "#88c7ed",
      },
      {
        "token_type": "type",
        "foreground_color": "#53B20B",
      },
    ],
  },
  "experimental.theme_overrides": {
    "editor.background": "#1f1f1f",
    "editor.gutter.background": "#1f1f1f",
    "tab_bar.background": "#1f1f1f",
    "tab.active_background": "#1f1f1f",
    "tab.inactive_background": "#181818",
    "status_bar.background": "#1f1f1f",
    "panel.background": "#1f1f1f",
    "background": "#1f1f1f",
    "title_bar.background": "#1f1f1f",
    "title_bar.inactive_background": "#2b2b2b",
    "border": "#2b2b2b",
    "terminal.background": "#1f1f1f",
    "elevated_surface.background": "#1f1f1f",

    "version_control.added": "#487E02",
    "version_control.modified": "#1B81A8",
    "hint": "#494949", //git blame color
    "syntax": {
      "keyword": {
        "color": "#9872A2",
      },
      "function": {
        "color": "#d97705",
      },
      "string": {
        "color": "#9AA83A",
      },
      "punctuation": {
        "color": "#676867",
      },
      "punctuation.bracket": {
        "color": "#676867",
      },
      "punctuation.delimiter": {
        "color": "#676867",
      },
      "punctuation.special": {
        "color": "#676867",
      },
      "operator": {
        "color": "#676867",
      },
      "number": {
        "color": "#408080",
      },
      "boolean": {
        "color": "#408080",
      },
      "comment": {
        "color": "#525252",
      },
      "comment.doc": {
        "color": "#525252",
      },
      //null, undefined, "center, flex" - keywords in css
      "constant.builtin": {
        "color": "#408080",
      },
      // this, super
      "variable.special": {
        "color": "#C7444A",
      },
      "export": {
        "color": "#C7444A",
      },
      "tag": {
        "color": "#3B8CB8",
      },
      "attribute": {
        "color": "#D0B344",
      },
      "selector": {
        "color": "#D0B344",
      },
      "type": {
        "color": "#4EC9B0",
      },
      "class": {
        "color": "#4EC9B0",
        "font_style": "italic",
      },
      "property": {
        "color": "#88c7ed",
      },
      "variable": {
        "color": "#88c7ed",
      },
      "variable.parameter": {
        "color": "#0D6A3D",
        "font_style": "italic",
      },

      // CSS units
      "type.unit": {
        "color": "#676767",
      },
    },
  },
}

// https://github.com/catppuccin/zed/blob/main/themes/catppuccin-no-italics-mauve.json - for referencing proper tokens
