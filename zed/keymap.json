[
  // Переключение вкладок работает везде (в коде, настройках, превью и т.д.)
  {
    "context": "Pane",
    "bindings": {
      "alt-right": "pane::ActivateNextItem",
      "alt-left": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",
      "alt-h": "pane::ActivatePreviousItem",
    },
  },
  // Бинды только для редактора кода
  {
    "context": "Editor",
    "bindings": {
      "tab": "pane::AlternateFile",
      "ctrl-/": ["editor::ToggleComments", { "advance_downwards": false }],
      "ctrl-c": ["editor::ToggleComments", { "advance_downwards": false }],
      "ctrl-r": "editor::Hover",
      "space k": "editor::Hover",
      "ctrl-w": "pane::CloseActiveItem",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "U": "vim::Redo",
      "ctrl-e": "project_panel::Toggle",
      "space p": "command_palette::Toggle",
      "f1": "editor::Rename",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-e": "project_panel::Toggle",
      "space f": "file_finder::Toggle",
      "ctrl-`": ["action::Sequence", ["terminal_panel::Toggle"]],
      "space g": ["action::Sequence", ["git_panel::Toggle"]],
    },
  },

  {
    "context": "(ProjectPanel && not_editing)",
    "bindings": {
      "space p": "command_palette::Toggle",
      "space f": "file_finder::Toggle",
      "d": "project_panel::Delete",
      "f": "project_panel::NewDirectory",
      "n": "project_panel::NewFile",
      "r": "project_panel::Rename",
      "f1": "project_panel::Rename",
      "0": "file_finder::Toggle",
      "insert": "file_finder::Toggle",
    },
  },
  {
    "context": "vim_mode == helix_normal",
    "bindings": {
      // "m": "workspace::ToggleHelixMode",
      "alt-e": "vim::EndOfLine",
      "alt-q": "vim::StartOfLine",
      "alt-w": "vim::MiddleOfLine",
      "ctrl-s": "workspace::Save",
      "escape": "editor::Cancel",
      "0": "file_finder::Toggle",
      "insert": "file_finder::Toggle",
      "ctrl-insert": "command_palette::Toggle",
      "ctrl-0": "command_palette::Toggle",
      "space d": ["workspace::SendKeystrokes", "\" _ d"],
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      // "m": "vim::Matching",
      "alt-e": "vim::EndOfLine",
      "alt-q": "vim::StartOfLine",
      "alt-w": "vim::MiddleOfLine",
      "space d": ["workspace::SendKeystrokes", "\" _ d"],
    },
  },

  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-s": ["workspace::SendKeystrokes", "escape : w enter"],
      "alt-e": "vim::EndOfLine",
      "alt-q": "vim::StartOfLine",
      "alt-w": "vim::MiddleOfLine",
      "ctrl-v": "editor::Paste",
      "shift-u": null,
      "space f": null,
      "space g": null,
      "space p": null,
      "space k": null,
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "space g": null,
      "space f": null,
      "space p": null,
    },
  },
]
